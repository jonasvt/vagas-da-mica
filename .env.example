# Copie para .env e preencha. O .env não vai para o Git.

# Bot do Discord (obrigatório): portal do Discord → seu app → Bot → Reset Token
DISCORD_TOKEN=
# Opcional: ID do seu servidor, para os comandos aparecerem na hora
DISCORD_GUILD_ID=

# Opcional: ler e-mails de alerta do LinkedIn/Upwork (somente leitura)
# No Gmail: ative a verificação em duas etapas e crie uma "senha de app"
IMAP_USER=
IMAP_PASSWORD=
# IMAP_HOST=imap.gmail.com
